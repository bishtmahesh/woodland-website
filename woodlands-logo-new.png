<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Maida Smiles &mdash; Final SEO &amp; Migration Report (WordPress &rarr; Webflow)</title>
<link rel="icon" type="image/png" href="RemedoLogo_Favicon_Circular.png">

<style>
  :root {
    --bg:#f7f8fa; --card:#ffffff; --text:#0f1720; --text-soft:#334155; --muted:#6b7686; --muted-soft:#94a1b2;
    --border:#e8eaee; --border-soft:#eef0f3;
    --accent:#2f5fe0; --accent-dark:#2347b8; --accent-bg:#eef2ff; --accent-ring:rgba(47,95,224,.16);
    --green:#0d9463; --green-bg:#e8f8f1; --amber:#c2760a; --amber-bg:#fdf3e2; --red:#d1425a; --red-bg:#fdecef;
    --sidebar-w:280px; --radius-lg:14px; --radius-md:10px; --radius-sm:7px;
    --shadow-xs:0 1px 2px rgba(15,23,42,.045);
    --shadow-sm:0 1px 2px rgba(15,23,42,.04), 0 2px 6px rgba(15,23,42,.05);
    --shadow-md:0 2px 4px rgba(15,23,42,.04), 0 8px 20px rgba(15,23,42,.06);
    --sp-1:4px; --sp-2:8px; --sp-3:12px; --sp-4:16px; --sp-5:20px; --sp-6:28px; --sp-7:36px;
    --topbar-h:90px;
  }
  * { box-sizing:border-box; }
  html,body { height:100%; }
  body {
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;
    background:var(--bg); color:var(--text); margin:0;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    font-size:14px; line-height:1.6;
  }
  a { color:var(--accent); text-decoration:none; transition:opacity .12s ease; }
  a:hover { text-decoration:underline; }
  code { background:#f1f3f7; border-radius:5px; padding:1.5px 6px; font-size:.88em; font-family:ui-monospace,"SF Mono",Menlo,monospace; color:#334155; }
  h2, h3 { font-weight:700; color:var(--text); letter-spacing:-.01em; }
  h2 { font-size:16px; margin:var(--sp-6) 0 var(--sp-3); }
  h3 { font-size:14.5px; margin:var(--sp-5) 0 var(--sp-2); }
  p { margin:0 0 var(--sp-3); }
  .tabular { font-variant-numeric:tabular-nums; }

  /* ===== Top bar =====
     Height is governed by --topbar-h, sized to comfortably fit the two-row brand block
     (30px logo row + date row) on the right without clipping. .sidebar's sticky offset and
     .shell's min-height both read the same variable so nothing shifts out of sync if this
     block's content height ever changes again. */
  .topbar {
    display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; row-gap:12px;
    min-height:var(--topbar-h); padding:14px 30px;
    background:rgba(255,255,255,.92); backdrop-filter:saturate(180%) blur(8px);
    border-bottom:1px solid var(--border); position:sticky; top:0; z-index:40;
  }
  .topbar-title { min-width:0; flex:1 1 320px; }
  .topbar h1 { font-size:18px; font-weight:700; margin:0; letter-spacing:-.015em; color:var(--text); }
  .topbar .subtitle { color:var(--muted); font-size:12px; margin:4px 0 0; letter-spacing:0; }
  .topbar-meta {
    display:flex; flex-direction:column; align-items:flex-end; gap:8px;
    text-align:right; font-size:12px; color:var(--muted); flex-shrink:0;
  }
  .topbar-meta strong { color:var(--text); font-weight:600; font-size:13px; }
  .topbar-date { line-height:1.4; }
  .prepared-by { display:inline-flex; align-items:center; gap:10px; justify-content:flex-end; }
  .prepared-by img { height:30px; width:auto; display:block; opacity:.95; flex-shrink:0; }
  .prepared-by-footer { justify-content:center; }

  /* ===== Shell layout ===== */
  .shell { display:flex; align-items:flex-start; min-height:calc(100vh - var(--topbar-h)); }

  /* ===== Sidebar — premium SaaS nav ===== */
  .sidebar {
    width:var(--sidebar-w); flex-shrink:0; background:var(--card);
    border-right:1px solid var(--border); position:sticky; top:var(--topbar-h);
    height:calc(100vh - var(--topbar-h));
    display:flex; flex-direction:column;
  }
  .sidebar-logo { display:flex; justify-content:center; align-items:center; flex-shrink:0; }
  .sidebar-logo img { height:22px; width:auto; opacity:.82; display:block; }
  .sidebar-logo-top { padding:18px 14px 16px; border-bottom:1px solid var(--border-soft); }
  .sidebar-logo-bottom { padding:14px 14px 18px; border-top:1px solid var(--border-soft); }
  .sidebar-scroll { flex:1 1 auto; min-height:0; overflow-y:auto; padding:16px 14px 20px; }
  .sidebar-group-label {
    font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.08em;
    color:var(--muted-soft); margin:26px 12px 10px; padding-top:2px;
  }
  .sidebar-group-label:first-child { margin-top:4px; }
  .side-nav-item {
    position:relative; display:flex; align-items:center; gap:11px; width:100%; text-align:left;
    background:transparent; border:none; border-radius:var(--radius-sm);
    padding:9.5px 12px 9.5px 15px; margin:0 0 2px; font-size:13.3px; font-weight:500;
    color:var(--text-soft); cursor:pointer; letter-spacing:0;
    transition:background-color .15s ease, color .15s ease, box-shadow .15s ease, transform .15s ease;
  }
  .side-nav-item::before {
    content:""; position:absolute; left:0; top:7px; bottom:7px; width:3px; border-radius:3px;
    background:transparent; transition:background-color .15s ease, transform .15s ease;
    transform:scaleY(.4); transform-origin:center;
  }
  .side-nav-item:hover { background:#f4f5f8; color:var(--text); transform:translateX(1px); }
  .side-nav-item.active {
    background:linear-gradient(135deg, var(--accent-bg) 0%, #f6f8ff 100%);
    color:var(--accent-dark); font-weight:700;
    box-shadow:inset 0 0 0 1px var(--accent-ring);
  }
  .side-nav-item.active::before { background:var(--accent); transform:scaleY(1); }
  .side-dot { width:7px; height:7px; border-radius:50%; flex-shrink:0; box-shadow:0 0 0 3px transparent; transition:box-shadow .15s ease; }
  .side-nav-item.active .side-dot { box-shadow:0 0 0 3px rgba(47,95,224,.12); }
  .side-dot.done { background:var(--green); } .side-dot.partial { background:var(--amber); } .side-dot.pending { background:var(--red); } .side-dot.info { background:#b8c0cc; }
  .side-label { flex:1; line-height:1.35; }
  .sidebar-scroll::-webkit-scrollbar { width:8px; }
  .sidebar-scroll::-webkit-scrollbar-thumb { background:#e2e5ea; border-radius:4px; }
  .sidebar-scroll::-webkit-scrollbar-track { background:transparent; }

  .main { flex:1; min-width:0; padding:32px 40px 72px; max-width:1360px; }
  .tab-panel { display:none; }
  .tab-panel.active { display:block; animation:fadein .15s ease; }
  @keyframes fadein { from { opacity:0; transform:translateY(3px); } to { opacity:1; transform:translateY(0); } }

  /* ===== Summary cards ===== */
  .sumcard {
    display:flex; gap:16px; background:var(--card); border:1px solid var(--border-soft);
    border-radius:var(--radius-lg); box-shadow:var(--shadow-sm); padding:20px 22px; margin-bottom:20px;
  }
  .sumcard-icon {
    font-size:19px; line-height:1; flex-shrink:0; width:40px; height:40px; border-radius:11px;
    display:flex; align-items:center; justify-content:center; background:#f1f3f7;
  }
  .sumcard.done .sumcard-icon { background:var(--green-bg); }
  .sumcard.partial .sumcard-icon { background:var(--amber-bg); }
  .sumcard.pending .sumcard-icon { background:var(--red-bg); }
  .sumcard.info .sumcard-icon { background:#f1f3f7; }
  .sumcard-body { min-width:0; }
  .sumcard-head { display:flex; align-items:center; gap:10px; margin-bottom:7px; flex-wrap:wrap; }
  .sumcard-head strong { font-size:14.5px; font-weight:700; color:var(--text); letter-spacing:-.005em; }
  .sumcard-text { font-size:13.3px; line-height:1.7; color:var(--text-soft); }
  .pill {
    font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.05em;
    padding:3px 10px; border-radius:999px; white-space:nowrap;
  }
  .pill.done { background:var(--green-bg); color:var(--green); }
  .pill.partial { background:var(--amber-bg); color:var(--amber); }
  .pill.pending { background:var(--red-bg); color:var(--red); }
  .pill.info { background:#f1f3f7; color:var(--muted); }

  /* One reusable "hallmark" treatment for the single most important card on a tab (used once
     on Overview, for the project-lifetime fix count) -- same gradient + top-edge language as
     .hero-card.accent, so the two moments of emphasis on this page read as one system. */
  .sumcard.highlight {
    position:relative; align-items:flex-start; overflow:hidden;
    background:linear-gradient(160deg, #eef2ff 0%, #ffffff 60%);
    border-color:#dde5fb;
  }
  .sumcard.highlight::before {
    content:""; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg, var(--accent), #6b8bf0);
  }
  .sumcard.highlight .sumcard-icon { background:var(--accent-bg); }
  .sumcard.highlight .sumcard-head strong { font-size:18px; }

  /* ===== Hero stat cards (Overview) =====
     Two-tier hierarchy, deliberately: the WP/Webflow page-count pair (.accent) is the
     report's one identity fact worth visually leading with, so it gets a quiet gradient
     wash + a colored top edge -- everything else stays plain white so it doesn't compete. */
  .hero-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:14px; margin:4px 0 28px; }
  .hero-card {
    position:relative; background:var(--card); border:1px solid var(--border-soft); border-radius:var(--radius-lg);
    box-shadow:var(--shadow-sm); padding:19px 20px 17px; overflow:hidden;
    transition:box-shadow .18s ease, transform .18s ease, border-color .18s ease;
  }
  .hero-card:hover { box-shadow:var(--shadow-md); transform:translateY(-1px); border-color:#dde3ee; }
  .hero-card .big { font-size:29px; font-weight:800; letter-spacing:-.025em; line-height:1.05; color:var(--text); font-variant-numeric:tabular-nums; }
  .hero-card .lbl { font-size:11.5px; color:var(--muted); margin-top:7px; font-weight:500; letter-spacing:.005em; line-height:1.4; }
  .hero-card .lbl-note { font-size:10px; color:var(--muted); opacity:.75; margin-top:3px; font-weight:400; line-height:1.35; }
  .hero-card.accent {
    background:linear-gradient(160deg, #eef2ff 0%, #ffffff 65%);
    border-color:#dde5fb;
  }
  .hero-card.accent::before {
    content:""; position:absolute; top:0; left:0; right:0; height:3px;
    background:linear-gradient(90deg, var(--accent), #6b8bf0);
  }
  .hero-card.accent .big { color:var(--accent-dark); }
  .hero-card.green .big { color:var(--green); }
  .hero-card.amber .big { color:var(--amber); }

  /* ===== Checklist ===== */
  .checklist { background:var(--card); border:1px solid var(--border-soft); border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-sm); margin-bottom:24px; }
  .check-row {
    position:relative; display:flex; align-items:center; gap:14px; padding:12px 20px 12px 23px;
    border-bottom:1px solid var(--border-soft); font-size:13px;
    transition:background-color .15s ease;
  }
  .check-row::before {
    content:""; position:absolute; left:0; top:8px; bottom:8px; width:3px; border-radius:3px;
    background:transparent; transition:background-color .15s ease, transform .15s ease;
    transform:scaleY(.4);
  }
  .check-row:hover { background:#fafbfc; }
  .check-row:hover::before { background:var(--border); transform:scaleY(1); }
  .check-row:last-child { border-bottom:none; }
  .check-row .cname { font-weight:600; width:222px; flex-shrink:0; color:var(--text); }
  .check-row .cnote { color:var(--text-soft); flex:1; line-height:1.6; }

  /* ===== Tables (shared) ===== */
  table {
    width:100%; border-collapse:collapse; background:var(--card);
    box-shadow:var(--shadow-sm); border-radius:var(--radius-md); overflow:hidden; font-size:13px;
  }
  th, td { padding:10px 14px; text-align:left; border-bottom:1px solid var(--border-soft); vertical-align:top; }
  th {
    background:#fafbfc; font-weight:700; color:#5b6675; font-size:11px;
    text-transform:uppercase; letter-spacing:.04em; position:sticky; top:0;
    border-bottom:1px solid var(--border);
  }
  tbody tr:last-child td { border-bottom:none; }
  td { transition:background-color .1s ease; }
  tr:hover td { background:#fafbfd; }
  .path-cell { font-family:ui-monospace,Menlo,monospace; font-size:12px; color:var(--text-soft); white-space:nowrap; max-width:220px; overflow:hidden; text-overflow:ellipsis; }
  .same, .ok, .pass { color:var(--green); font-weight:600; white-space:nowrap; }
  .diff, .bad, .no, .crit { color:var(--red); font-weight:600; white-space:nowrap; }
  .wa, .med, .high { color:var(--amber); font-weight:600; white-space:nowrap; }
  .low { color:var(--accent); font-weight:600; }
  .na, .excluded { color:var(--muted); font-weight:600; white-space:nowrap; }
  .row-missing td { background:var(--amber-bg); }
  .row-hidden { display:none; }
  .missing-note { color:var(--red); font-style:italic; }
  .matched { color:var(--green); font-weight:600; white-space:nowrap; }
  .page-search-input, .status-filter, .site-filter {
    padding:8px 13px; border:1px solid var(--border); border-radius:var(--radius-sm);
    font-size:13px; background:var(--card); color:var(--text);
  }
  .page-search-input:focus, .status-filter:focus, .site-filter:focus { outline:none; border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-ring); }
  .panel-summary { display:flex; align-items:center; gap:14px; margin-bottom:14px; flex-wrap:wrap; }
  .toggle-diff { margin-left:auto; font-size:13px; color:var(--muted); display:flex; align-items:center; gap:6px; }
  .top-summary { display:flex; gap:12px; margin-bottom:18px; flex-wrap:wrap; }
  .summary-tile { background:var(--card); border-radius:var(--radius-md); padding:13px 18px; box-shadow:var(--shadow-xs); min-width:140px; border:1px solid var(--border-soft); }
  .summary-tile .num { font-size:21px; font-weight:800; display:block; letter-spacing:-.01em; font-variant-numeric:tabular-nums; }
  .summary-tile .lbl { font-size:11px; color:var(--muted); margin-top:2px; }
  .summary-tile.total .num { color:var(--accent); } .summary-tile.diff .num { color:var(--red); } .summary-tile.same .num { color:var(--green); } .summary-tile.missing .num { color:var(--red); }
  .mini-stats { display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; }
  .mini-stats .stat { font-size:12px; font-weight:700; padding:5px 11px; border-radius:var(--radius-sm); background:#f1f3f7; color:#5b6675; }
  .link-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  .link-card { background:var(--card); border:1px solid var(--border-soft); border-radius:var(--radius-lg); padding:18px; box-shadow:var(--shadow-sm); }
  .link-card h3 { font-size:13.5px; margin:0 0 12px; }
  .link-card table { max-height:360px; display:block; overflow-y:auto; }
  .link-card thead, .link-card tbody { display:table; width:100%; table-layout:fixed; }
  @media (max-width:900px) { .link-grid { grid-template-columns:1fr; } }
  tr[data-path^="/es/"], tr[data-path^="/pt/"] { opacity:.4; }
  tr[data-path^="/es/"] .path-cell::after, tr[data-path^="/pt/"] .path-cell::after { content:" (out of scope \2014 ES/PT)"; font-size:10px; color:var(--muted); font-weight:400; }
  .table-scroll { overflow-x:auto; overflow-y:auto; max-height:640px; border:1px solid var(--border-soft); border-radius:var(--radius-md); margin:16px 0; box-shadow:var(--shadow-xs); }

  /* ===== Callouts ===== */
  /* One callout language, reused everywhere (incl. the Pricing tab's .callout below) --
     a quiet neutral card with a single colored left edge, not a fully-saturated box. */
  .callout2 {
    border-radius:var(--radius-md); padding:13px 18px; margin:14px 0; font-size:13px; line-height:1.65;
    background:var(--card); border:1px solid var(--border-soft); border-left:3px solid var(--muted-soft);
    box-shadow:var(--shadow-xs); color:var(--text-soft);
  }
  .callout2.info { border-left-color:var(--accent); }
  .callout2.info h4 { color:var(--accent-dark); }
  .callout2.warn { border-left-color:var(--amber); }
  .callout2.warn h4 { color:var(--amber); }
  .callout2.good { border-left-color:var(--green); }
  .callout2.good h4 { color:var(--green); }
  .callout2 h4 { margin:0 0 6px; font-size:11px; text-transform:uppercase; letter-spacing:.05em; font-weight:700; color:var(--text); }

  /* ===== Tick/checkmark list (Overview breakdown, etc.) =====
     Demoted a step below the surrounding prose (smaller, tighter, muted-soft body text) so
     a long itemized breakdown reads as reference detail supporting the headline number above
     it, not as equally-weighted content competing with it. */
  .tick-list { list-style:none; padding:0; font-size:12.5px; color:var(--text-soft); }
  .tick-list li {
    position:relative; padding:5px 0 5px 22px; margin:0; break-inside:avoid;
    border-bottom:1px solid var(--border-soft); line-height:1.5;
  }
  .tick-list li:last-child { border-bottom:none; }
  .tick-list li::before {
    content:"\2713"; position:absolute; left:2px; top:6px; color:var(--green);
    font-weight:700; font-size:11px;
  }

  /* ===== Migration phase cards (kept for compatibility with any embedded source markup) ===== */
  .phase { background:var(--card); border-radius:var(--radius-lg); border:1px solid var(--border-soft); margin-bottom:18px; overflow:hidden; box-shadow:var(--shadow-sm); }
  .ph-head { padding:14px 20px; display:flex; align-items:center; gap:12px; border-bottom:1px solid var(--border-soft); }
  .ph-icon { width:34px; height:34px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0; }
  .ph-icon.g { background:var(--green-bg); } .ph-icon.a { background:var(--amber-bg); } .ph-icon.r { background:var(--red-bg); }
  .ph-title { font-size:14px; font-weight:700; flex:1; }
  .ph-sub { font-size:11.5px; color:var(--muted-soft); margin-top:2px; }
  .ph-tag { font-size:10px; font-weight:700; padding:3px 10px; border-radius:20px; text-transform:uppercase; letter-spacing:.04em; flex-shrink:0; }
  .tag-g { background:var(--green-bg); color:#0b5c3e; } .tag-a { background:var(--amber-bg); color:#6b3f06; } .tag-r { background:var(--red-bg); color:#7a1830; }
  .ph-body { padding:16px 20px; }
  .ig { display:grid; grid-template-columns:1fr 1fr; gap:9px; }
  @media (max-width:680px) { .ig { grid-template-columns:1fr; } }
  .item { display:flex; align-items:flex-start; gap:9px; padding:11px 14px; background:#fafbfc; border-radius:var(--radius-sm); border:1px solid var(--border-soft); font-size:12.6px; }
  .item.full { grid-column:1/-1; }
  .item-ico { flex-shrink:0; font-size:13px; margin-top:1px; }
  .item-txt strong { display:block; font-weight:700; color:var(--text); line-height:1.4; margin-bottom:2px; }
  .item-txt span { color:var(--muted); font-size:12px; }
  .slbl { font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--muted-soft); margin:20px 0 9px; }
  table.t th { text-transform:uppercase; font-size:10.5px; }

  /* Overview-specific rhythm: a touch more air between major blocks than the denser detail
     tabs get, since this is the first-impression page and deserves room to breathe. */
  #panel-overview > .sumcard { margin-bottom:24px; }
  #panel-overview > .callout2 { margin:24px 0; }
  #panel-overview > h3 { margin-top:32px; margin-bottom:14px; }

  footer.report-footer { text-align:center; padding:30px 20px 44px; color:var(--muted); font-size:12px; border-top:1px solid var(--border); margin-top:32px; line-height:1.7; }
  footer.report-footer strong { color:var(--text-soft); }
  /* each footer line is its own block so the tall inline logo on the brand line can never
     crowd the title line above or the scope note below -- normal block flow keeps them apart. */
  .footer-line { margin:0 0 14px; }
  .footer-line:last-child { margin-bottom:0; }
  .footer-title { font-weight:600; color:var(--text-soft); font-size:12.5px; }
  .footer-brand { display:flex; flex-direction:column; align-items:center; gap:8px; }
  .footer-date { color:var(--muted); }
  .footer-scope { max-width:640px; margin-left:auto; margin-right:auto; }

  /* ===== Pricing Accuracy tab (reused classes from the price-verification source doc) ===== */
  #panel-pricing .callout { background:var(--card); border-left:4px solid var(--accent); padding:14px 18px; border-radius:var(--radius-md); margin:14px 0; font-size:13px; line-height:1.65; border-top:1px solid var(--border-soft); border-right:1px solid var(--border-soft); border-bottom:1px solid var(--border-soft); box-shadow:var(--shadow-xs); }
  #panel-pricing .callout.warn { border-left-color:var(--amber); }
  #panel-pricing .callout.crit { border-left-color:var(--red); }
  #panel-pricing .score-grid { display:flex; gap:14px; flex-wrap:wrap; margin:16px 0; }
  #panel-pricing .score-card { background:var(--card); border:1px solid var(--border-soft); border-radius:var(--radius-md); padding:16px 20px; min-width:140px; flex:1; box-shadow:var(--shadow-xs); }
  #panel-pricing .score-card .big { font-size:25px; font-weight:800; font-variant-numeric:tabular-nums; letter-spacing:-.02em; }
  #panel-pricing .score-card .label { color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.04em; margin-top:5px; }
  #panel-pricing .big.ok { color:var(--green); } #panel-pricing .big.fix { color:var(--red); } #panel-pricing .big.flag { color:var(--amber); } #panel-pricing .big.bug { color:var(--accent); }
  #panel-pricing .cat-block { margin-top:26px; }
  #panel-pricing .cat-head { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  #panel-pricing .cat-head h3 { font-size:14.5px; margin:0; }
  #panel-pricing .badge { display:inline-block; padding:3px 10px; border-radius:999px; font-size:10px; font-weight:700; letter-spacing:.03em; }
  #panel-pricing .badge.ok { background:var(--green-bg); color:var(--green); }
  #panel-pricing .badge.issue { background:var(--amber-bg); color:var(--amber); }
  #panel-pricing .act-ok { color:var(--green); font-weight:600; }
  #panel-pricing .act-fix { color:var(--red); font-weight:700; }
  #panel-pricing .act-flag { color:var(--muted); }
  #panel-pricing .act-bug { color:var(--accent); }
  #panel-pricing .evidence { color:var(--muted); font-size:12px; font-style:italic; max-width:280px; }
  #panel-pricing .loc-tag { font-size:10.5px; background:#f1f3f7; color:var(--muted); padding:1px 7px; border-radius:999px; border:1px solid var(--border); }
  #panel-pricing h2 { font-size:16px; margin-top:32px; border-bottom:1px solid var(--border-soft); padding-bottom:8px; }
  #panel-pricing footer { margin-top:20px; color:var(--muted); font-size:12px; text-align:left; border:none; padding:0; }
</style>

</head>
