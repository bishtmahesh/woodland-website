<div class="sumcard good" style="margin-top:20px;">
<div class="sumcard-icon">✅</div>
<div class="sumcard-body">
<div class="sumcard-head"><span class="pill good">Cross-checked 28 Jul 2026</span><strong>Screaming Frog crawl cross-check — 3 additional live defects found and fixed</strong></div>
<div class="sumcard-text">A separate Screaming Frog crawl (folder: <code>screaming frog/</code>) was reviewed against this table on 2026-07-28. Two of its flags (H1 non-sequential on /dentist-referrals; the bulk of h2_duplicate/h2_nonsequential — 165 rows) were template/nav-pattern artefacts, not real defects, and were not actioned. Its 111-row 4xx report and this table's broken-link/redirect rows were excluded from this pass per standing instruction — no link or redirect work was done. Three genuine, previously-uncaught defects were found and fixed:
<ul style="margin:8px 0 0 20px;">
<li><strong>Lorem ipsum placeholder text</strong> live on /london/st-johns-wood, in the "New patient exam from £110" section — replaced with the real page-specific copy already published on the equivalent WordPress page (verbatim, not invented).</li>
<li><strong>Empty H2 / missing role</strong> on /team/dr-sameera-hamid — her CMS "role" field was null; set to "General Dentist", confirmed against the WordPress source and her own existing meta-title.</li>
<li><strong>2 images missing alt text</strong> (site-wide UI icons: a cross-mark and a direction arrow, one used 548×) — marked decorative (empty alt) per accessibility best practice, since they carry no content meaning.</li>
</ul>
All three verified live on maidasmiles.co.uk after publish.</div>
</div>
</div>

<script>
(function() {
  var input = document.getElementById('post-migration-search');
  if (!input) return;
  input.addEventListener('input', function() {
    var q = input.value.toLowerCase();
    document.querySelectorAll('#tbody-post-migration tr').forEach(function(tr) {
      tr.style.display = tr.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
    });
  });
})();
</script>
</div>


<footer class="report-footer">
  <div class="footer-line footer-title">Maida Smiles &mdash; WordPress &rarr; Webflow Migration &amp; SEO Report</div>
  <div class="footer-line footer-brand">
    <span class="footer-date">21 July 2026</span>
  </div>
  <div class="footer-line footer-scope">Scope: English-locale pages only &mdash; excludes ES/PT locales, the deprecated Services CMS collection, and any draft/archived items.</div>
</footer>
  </main>
</div>

<script>
  document.querySelectorAll('.side-nav-item').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.side-nav-item').forEach(function(b) { b.classList.remove('active'); });
      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
      btn.classList.add('active');
      var panel = document.getElementById('panel-' + btn.dataset.tab);
      if (panel) panel.classList.add('active');
      window.scrollTo({top:0, behavior:'instant'});
    });
  });

  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
    });
  });
  const pageSearchInput = document.getElementById('page-search');
  const allPagesDiffToggle = document.getElementById('all-pages-diff-toggle');
  const allPagesStatusFilter = document.getElementById('all-pages-status-filter');
  function filterAllPages() {
    const q = (pageSearchInput.value || '').toLowerCase();
    const diffOnly = allPagesDiffToggle.checked;
    const statusVal = allPagesStatusFilter ? allPagesStatusFilter.value : 'all';
    document.querySelectorAll('#all-pages-container .page-card').forEach(card => {
      const path = card.dataset.path || '';
      const matchesSearch = !q || path.includes(q);
      const hasDiff = !!card.querySelector('.page-card-header .diff');
      const matchesDiff = !diffOnly || hasDiff;
      const matchesStatus = statusVal === 'all' || (statusVal === 'diff' && hasDiff) || (statusVal === 'matched' && !hasDiff);
      card.style.display = (matchesSearch && matchesDiff && matchesStatus) ? '' : 'none';
    });
  }
  if (pageSearchInput) pageSearchInput.addEventListener('input', filterAllPages);
  if (allPagesDiffToggle) allPagesDiffToggle.addEventListener('change', filterAllPages);
  if (allPagesStatusFilter) allPagesStatusFilter.addEventListener('change', filterAllPages);

  function filterTab(tabId) {
    const searchInput = document.querySelector('.tab-search[data-target="' + tabId + '"]');
    const statusSelect = document.querySelector('.status-filter[data-target="' + tabId + '"]');
    const q = searchInput ? (searchInput.value || '').toLowerCase() : '';
    const statusVal = statusSelect ? statusSelect.value : 'all';
    const tbody = document.getElementById('tbody-' + tabId);
    if (!tbody) return;
    tbody.querySelectorAll('tr').forEach(tr => {
      const path = tr.dataset.path || '';
      const status = tr.dataset.status || '';
      const matchesSearch = !q || path.includes(q);
      const matchesStatus = statusVal === 'all' || status === statusVal;
      tr.classList.toggle('row-hidden', !(matchesSearch && matchesStatus));
    });
  }
  document.querySelectorAll('.tab-search').forEach(inp => {
    inp.addEventListener('input', () => filterTab(inp.dataset.target));
  });
  document.querySelectorAll('.status-filter').forEach(sel => {
    sel.addEventListener('change', () => filterTab(sel.dataset.target));
  });

  function filterPanel(panelId) {
    const searchInput = document.querySelector('.panel-search[data-target="' + panelId + '"]');
    const siteSelect = document.querySelector('.site-filter[data-target="' + panelId + '"]');
    const q = searchInput ? (searchInput.value || '').toLowerCase() : '';
    const siteVal = siteSelect ? siteSelect.value : 'all';
    const panel = document.getElementById('panel-' + panelId);
    if (!panel) return;
    panel.querySelectorAll('tr[data-path]').forEach(tr => {
      const path = tr.dataset.path || '';
      const matchesSearch = !q || path.includes(q);
      const siteCell = tr.querySelector('td:last-child');
      const siteText = siteCell ? siteCell.textContent.trim() : '';
      const matchesSite = siteVal === 'all' || siteText === siteVal;
      tr.classList.toggle('row-hidden', !(matchesSearch && matchesSite));
    });
  }
  document.querySelectorAll('.panel-search').forEach(inp => {
    inp.addEventListener('input', () => filterPanel(inp.dataset.target));
  });
  document.querySelectorAll('.site-filter').forEach(sel => {
    sel.addEventListener('change', () => filterPanel(sel.dataset.target));
  });

</script>
</body>
</html>
